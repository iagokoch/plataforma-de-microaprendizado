# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# --- Aplicação principal ---
PORT=3001
# URL pública usada no link do e-mail de recuperação de senha
APP_URL=http://localhost:3001
# String longa e aleatória. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Banco de dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=microlearn

# --- Painel administrativo ---
ADMIN_PORT=4000
ADMIN_USER=
# Hash bcrypt da senha do admin (nunca a senha em texto). Gere com:
#   npm run hash-password -- "sua-senha-forte"
# Coloque entre aspas simples, porque o hash contém "$".
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- E-mail (Nodemailer) — usado na recuperação de senha ---
# Gmail com verificação em 2 etapas exige uma "Senha de App".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
